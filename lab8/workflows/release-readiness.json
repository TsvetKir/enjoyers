{
  "id": "lab8ReleaseReview",
  "name": "ParcelDesk — release readiness",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "release-review",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "release-trigger",
      "name": "Release webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "lab8-release-review"
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\nif (!/^2026\\.10\\.[12]$/.test(b.release ?? '') || (b.service ?? 'checkout') !== 'checkout') { throw new Error('Expected release 2026.10.1 or 2026.10.2 and service checkout'); }\nreturn [{json:{release:b.release,service:b.service ?? 'checkout'}}];"
      },
      "id": "validate-input",
      "name": "Validate release (non-AI)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agent:8000/review",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "ai-agent",
      "name": "AI agent with two MCP servers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "return-result",
      "name": "Return saved review",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        780,
        0
      ]
    }
  ],
  "connections": {
    "Release webhook": {
      "main": [
        [
          {
            "node": "Validate release (non-AI)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate release (non-AI)": {
      "main": [
        [
          {
            "node": "AI agent with two MCP servers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI agent with two MCP servers": {
      "main": [
        [
          {
            "node": "Return saved review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
